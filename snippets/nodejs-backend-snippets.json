{
  "Express Server Full HBS": {
    "prefix": "expServerFull",
    "body": [
      "import express from 'express';",
      "import { fileURLToPath } from 'url';",
      "import path from 'path';",
      "import { engine } from 'express-handlebars';",
      "import { createServer } from 'http';",
      "import cookieParser from 'cookie-parser';",
      "import dotenv from 'dotenv';",
      "",
      "// Configuración de __dirname para ES Modules",
      "const __filename = fileURLToPath(import.meta.url);",
      "const __dirname = path.dirname(__filename);",
      "",
      "// Cargar variables de entorno",
      "dotenv.config({ path: `.env.${process.env.NODE_ENV || 'development'}` });",
      "",
      "const app = express();",
      "const httpServer = createServer(app);",
      "const PORT = process.env.PORT || 8080;",
      "",
      "// Middlewares",
      "app.use(express.json());",
      "app.use(express.urlencoded({ extended: true }));",
      "app.use(cookieParser());",
      "",
      "// Archivos estáticos",
      "app.use('/static', express.static(path.join(__dirname, 'public')));",
      "",
      "// Motor de plantillas Handlebars",
      "app.engine('hbs', engine({ extname: '.hbs' }));",
      "app.set('view engine', 'hbs');",
      "app.set('views', path.join(__dirname, 'views'));",
      "",
      "// Ruta principal",
      "app.get('/', (req, res) => {",
      "\tres.render('${1:home}', {",
      "\t\ttitle: '${2:Mi Aplicación}',",
      "\t});",
      "});",
      "",
      "// Rutas",
      "$0",
      "",
      "// Iniciar servidor",
      "const startServer = async () => {",
      "\ttry {",
      "\t\t// Aquí puedes agregar conexión a DB",
      "\t\t",
      "\t\thttpServer.listen(PORT, () => {",
      "\t\t\tconsole.log(`Servidor corriendo en http://localhost:${PORT}`);",
      "\t\t});",
      "\t} catch (error) {",
      "\t\tconsole.error('Error al iniciar el servidor:', error);",
      "\t\tprocess.exit(1);",
      "\t}",
      "};",
      "",
      "startServer();"
    ],
    "description": "Servidor Express completo con HBS, static files, ES Modules y dotenv"
  },
  "Express Route": {
    "prefix": "expRoute",
    "body": [
      "router.${1|get,post,put,delete|}('${2:/path}', async (req, res) => {",
      "\ttry {",
      "\t\tconst { ${3:params} } = req.${4|body,params,query|};",
      "\t\t$0",
      "\t\tres.status(200).json({ success: true, data: ${5:result} });",
      "\t} catch (error) {",
      "\t\tres.status(500).json({ success: false, message: error.message });",
      "\t}",
      "});"
    ],
    "description": "Ruta Express con try-catch"
  },
  "Express Controller": {
    "prefix": "expController",
    "body": [
      "export const ${1:controllerName} = async (req, res) => {",
      "\ttry {",
      "\t\tconst { ${2:params} } = req.${3|body,params,query|};",
      "\t\t$0",
      "\t\tres.status(${4:200}).json({",
      "\t\t\tsuccess: true,",
      "\t\t\tmessage: '${5:Success message}',",
      "\t\t\tdata: ${6:result}",
      "\t\t});",
      "\t} catch (error) {",
      "\t\tres.status(500).json({",
      "\t\t\tsuccess: false,",
      "\t\t\tmessage: error.message",
      "\t\t});",
      "\t}",
      "};"
    ],
    "description": "Controlador Express con manejo de errores"
  },
  "Mongoose Model": {
    "prefix": "mongoModel",
    "body": [
      "import mongoose from 'mongoose';",
      "",
      "const ${1:modelName}Schema = new mongoose.Schema({",
      "\t${2:fieldName}: {",
      "\t\ttype: ${3|String,Number,Boolean,Date,Array,Object|},",
      "\t\trequired: ${4|true,false|},",
      "\t\tunique: ${5|false,true|},",
      "\t\tdefault: ${6:null}",
      "\t},$0",
      "}, {",
      "\ttimestamps: true,",
      "\tversionKey: false",
      "});",
      "",
      "export default mongoose.model('${1:modelName}', ${1:modelName}Schema);"
    ],
    "description": "Modelo de Mongoose completo"
  },
  "MongoDB Connection": {
    "prefix": "mongoConnect",
    "body": [
      "import mongoose from 'mongoose';",
      "",
      "const connectDB = async () => {",
      "\ttry {",
      "\t\tconst conn = await mongoose.connect(process.env.MONGO_URI);",
      "\t\tconsole.log(`MongoDB Connected: ${conn.connection.host}`);",
      "\t} catch (error) {",
      "\t\tconsole.error(`Error: ${error.message}`);",
      "\t\tprocess.exit(1);",
      "\t}",
      "};",
      "",
      "export default connectDB;"
    ],
    "description": "Función de conexión a MongoDB"
  },
  "Import Express Router": {
    "prefix": "impRouter",
    "body": [
      "import { Router } from 'express';",
      "",
      "const router = Router();",
      "",
      "$0",
      "",
      "export default router;"
    ],
    "description": "Import y setup de Express Router"
  }
}
