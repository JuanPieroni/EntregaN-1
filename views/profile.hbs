<link rel="stylesheet" href="/static/css/profile.css">

<div class="profile-container">
    <div class="profile-header">
        <h1>¡Bienvenido {{user.fullName}}!</h1>
    </div>

    <div class="profile-info">
        <h2>Información Personal</h2>
        <p><strong>Email:</strong> {{user.email}}</p>
        <p><strong>Nombre:</strong> {{user.fullName}}</p>
        <p><strong>Edad:</strong> {{user.age}}</p>
        <p><strong>Rol:</strong> {{user.role}}</p>
        {{#if user.cart}}
            <p><strong>Carrito ID:</strong> {{user.cart}}</p>
        {{/if}}
    </div>

    <div class="profile-actions">
        <a href="/products" class="btn-profile btn-products">Ver Productos</a>
        <form method="POST" action="/api/sessions/logout" style="display: inline;">
            <button type="submit" class="btn-profile btn-logout">Cerrar sesión</button>
        </form>
    </div>
</div>