<h1>Iniciar sesión</h1>

{{#if error}}
    <div style="color: red; margin-bottom: 10px;">¡Login fallido! Revisa tus credenciales</div>
{{/if}}

<form method="POST" action="/api/sessions/login">
    <div>
        <input name="email" placeholder="Email" type="email" required />
    </div>
    
    <div>
        <input name="password" placeholder="Contraseña" type="password" required />
    </div>
    
    <button type="submit">Ingresar</button>
</form>


<div style="margin: 20px 0; text-align: center;">
    <p>--- O ---</p>
    <a href="/api/sessions/github" style="background: #333; color: white; padding: 10px 20px; text-decoration: none; border-radius: 5px;">
        🐙 Iniciar sesión con GitHub
    </a>

    
<p><a href="/register">¿No tienes cuenta? Regístrate</a></p>