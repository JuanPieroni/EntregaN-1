{{! index.handlebars }}

<div class="header">
    <div>
        <h1>Hola {{user.fullName}}</h1>
        <h2>Listado de productos</h2>
    </div>
    <div class="header-actions">
        <a href="/carts" class="btn btn-secondary">Todos los carritos</a>
        <a href="/cart/{{userCartId}}" class="btn btn-primary">Ver carrito</a>
        <form method="POST" action="/api/sessions/logout" style="display: inline;">
            <button type="submit" class="btn btn-secondary">Logout</button>
        </form>
    </div>
</div>

<div class="products-grid">
    {{#each products.payload}}
        <div class="product-card">
            <h3 class="product-title">{{this.title}}</h3>
            <div class="product-price">${{this.price}}</div>
            <p class="product-description">{{this.description}}</p>
            <span class="product-category">{{this.category}}</span>
            <p class="product-stock {{#if this.stock}}stock-available{{else}}stock-unavailable{{/if}}">
                {{#if this.stock}}
                    ✓ En stock ({{this.stock}})
                {{else}}
                    ✗ Sin stock
                {{/if}}
            </p>
            <form
                action="/api/carts/{{@root.userCartId}}/product/{{this._id}}"
                method="POST"
                onsubmit="alertAgregarProducto('{{this.title}}')"
            >
                <button type="submit" class="btn btn-success">Agregar al carrito</button>
            </form>
        </div>
    {{/each}}
</div>

<div class="pagination">
    {{#if products.hasPrevPage}}
        <a href="/products?page={{products.prevPage}}" class="btn btn-primary">← Anterior</a>
    {{/if}}

    <span style="font-weight: bold;">Página {{products.page}} de {{products.totalPages}}</span>

    {{#if products.hasNextPage}}
        <a href="/products?page={{products.nextPage}}" class="btn btn-primary">Siguiente →</a>
    {{/if}}
</div>

<script src="/static/js/products.js"></script>