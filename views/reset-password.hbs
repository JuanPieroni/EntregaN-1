<h1>Restablecer Contraseña</h1>

{{#if success}}
    <div style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 5px; margin: 20px 0;">
        {{message}}
    </div>
    <a href="/login">Ir al login</a>
{{else}}
    {{#if error}}
        <div style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 5px; margin: 20px 0;">
            {{message}}
        </div>
    {{/if}}

    <form action="/api/sessions/reset-password" method="POST">
        <input type="hidden" name="token" value="{{token}}" />
        
        <label>Nueva Contraseña:</label>
        <input type="password" name="newPassword" required minlength="6" />
        
        <button type="submit">Restablecer Contraseña</button>
    </form>

    <a href="/forgot-password">Solicitar nuevo enlace</a>
{{/if}}
