<h1>Recuperar Contraseña</h1>

{{#if success}}
    <div
        style="padding: 10px; background-color: #d4edda; color: #155724; border: 1px solid #c3e6cb; border-radius: 5px; margin: 20px 0;"
    >
        {{message}}
    </div>
    <a href="/login">Volver al login</a>
{{else}}
    {{#if error}}
        <div
            style="padding: 10px; background-color: #f8d7da; color: #721c24; border: 1px solid #f5c6cb; border-radius: 5px; margin: 20px 0;"
        >
            {{message}}
        </div>
    {{/if}}

    <form action="/api/sessions/forgot-password" method="POST">
        <label>Email:</label>
        <input type="email" name="email" required />
        <button type="submit">Enviar enlace de recuperación</button>
    </form>

    <a href="/login">Volver al login</a>
{{/if}}