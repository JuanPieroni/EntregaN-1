<link rel="stylesheet" href="/static/css/auth.css">

<div class="auth-container">
    <h1>Registrarse</h1>

    {{#if error}}
        <div class="error-message">¡Registro fallido! Intenta nuevamente</div>
    {{/if}}

    <form method="POST" action="/api/sessions/register">
        <input name="first_name" placeholder="Nombre" type="text" required />
        <input name="last_name" placeholder="Apellido" type="text" required />
        <input name="email" placeholder="Email" type="email" required />
        <input name="age" placeholder="Edad" type="number" required />
        <input name="password" placeholder="Contraseña" type="password" required />
        <button type="submit">Registrarse</button>
    </form>

    <div class="auth-footer">
        <p><a href="/login">¿Ya tienes cuenta? Inicia sesión</a></p>
    </div>
</div>