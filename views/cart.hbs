<h1>Carrito {{cart._id}}</h1>

<ul>
    {{#each cart.products}}
        <li>
            <h3>{{this.product.title}}</h3>
            <p>Precio: ${{this.product.price}}</p>
            <p>Cantidad: {{this.cantidad}}</p>
        </li>
    {{/each}}
</ul>
 
{{#if cart.products.length}}
<form action="/cart/{{cart._id}}/purchase" method="POST" style="margin-top: 20px;">
    <button type="submit" style="padding: 10px 20px; background-color: green; color: white; border: none; cursor: pointer;">
        Finalizar Compra
    </button>
</form>

{{else}}
    <p>El carrito está vacío</p>
{{/if}}

<a href="/products" style="display: inline-block; margin-top: 10px;">Volver a
    productos</a>